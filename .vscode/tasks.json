{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "garage: setup",
      "type": "process",
      "command": "make",
      "args": [
        "setup"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "garage: debug prepare",
      "type": "process",
      "command": "make",
      "args": [
        "debug-prepare"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
