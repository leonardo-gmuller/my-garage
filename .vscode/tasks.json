      }
    },
    {
      "label": "garage: vite",
      "type": "process",
      "command": "make",
      "args": [
        "debug-vite"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        {
          "owner": "garage-vite",
          "pattern": {
            "regexp": "^(.+):(\\d+):(\\d+): (error|warning): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^\\[garagem\\] FRONTEND_START",
            "endsPattern": "^\\[garagem\\] FRONTEND_READY http://127\\.0\\.0\\.1:[0-9]+$"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "isBackground": true
    },
