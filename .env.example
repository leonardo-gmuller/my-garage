# Copie para .env e defina uma senha local antes de executar.
POSTGRES_DB=minha_garagem
POSTGRES_USER=garage
POSTGRES_PASSWORD=
FRONTEND_PORT=8080
# Acesso inicial. Defina uma senha própria com 10+ caracteres, maiúscula, minúscula e número.
# A conta só é criada quando o banco ainda não possui usuários.
BOOTSTRAP_EMAIL=demo@minhagaragem.local
BOOTSTRAP_PASSWORD=
# Opcional: collector OpenTelemetry, sem serviço pago obrigatório.
OTEL_EXPORTER_OTLP_ENDPOINT=

# IA opcional. Chave somente no backend; sem chave, o fluxo manual permanece disponível.
AI_ENABLED=true
AI_PROVIDER=Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=2048
AI_REQUESTS_PER_MINUTE=3
AI_REQUESTS_PER_USER_PER_DAY=20
AI_REQUESTS_PER_DAY=100
