# Copie para .env e defina uma senha local antes de executar.
POSTGRES_DB=minha_garagem
POSTGRES_USER=garage
POSTGRES_PASSWORD=
FRONTEND_PORT=8080
# Acesso inicial. Defina uma senha própria com 10+ caracteres, maiúscula, minúscula e número.
# A conta só é criada quando o banco ainda não possui usuários.
BOOTSTRAP_EMAIL=demo@minhagaragem.local
BOOTSTRAP_PASSWORD=
# Opcional: collector OpenTelemetry, sem serviço pago obrigatório.
OTEL_EXPORTER_OTLP_ENDPOINT=
